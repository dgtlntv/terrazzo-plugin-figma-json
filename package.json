{
  "name": "terrazzo-plugin-figma-json",
  "version": "0.0.0",
  "description": "Convert DTCG design tokens JSON into Figma-compatible design tokens JSON format.",
  "license": "MIT",
  "type": "module",
  "author": "dgtlntv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgtlntv/terrazzo-plugin-figma-json.git"
  },
  "bugs": {
    "url": "https://github.com/dgtlntv/terrazzo-plugin-figma-json/issues"
  },
  "homepage": "https://github.com/dgtlntv/terrazzo-plugin-figma-json#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "design tokens",
    "design system",
    "dtcg",
    "w3c",
    "figma",
    "terrazzo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c && tsc --emitDeclarationOnly",
    "dev": "rolldown -w -c",
    "format": "biome check --fix --unsafe .",
    "lint": "pnpm run \"/^lint:(js|ts)/\"",
    "lint:js": "biome check .",
    "lint:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@terrazzo/cli": "^2.0.0",
    "@terrazzo/parser": "^2.0.0"
  },
  "dependencies": {
    "colorjs.io": "^0.7.0",
    "wildcard-match": "^5.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@terrazzo/cli": "^2.4.0",
    "@terrazzo/parser": "^2.4.0",
    "@types/node": "^26.1.1",
    "rolldown": "^1.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.13.1"
}
