{
  "color": {
    "$type": "color",
    "brand": {
      "$value": { "colorSpace": "srgb", "components": [1, 0, 0] }
    }
  },
  "spacing": {
    "$type": "dimension",
    "medium": {
      "$value": { "value": 1, "unit": "rem" }
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "bold": {
      "$value": 700
    }
  }
}
