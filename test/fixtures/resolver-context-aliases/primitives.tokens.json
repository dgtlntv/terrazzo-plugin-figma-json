{
  "$schema": "https://designtokens.org/schemas/2025.10/format.json",
  "primitive": {
    "color": {
      "$type": "color",
      "white": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1]
        }
      },
      "black": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0]
        }
      }
    },
    "dimension": {
      "$type": "dimension",
      "thin": {
        "$value": {
          "value": 1,
          "unit": "px"
        }
      }
    }
  }
}
